                <div className=\"flex items-center gap-2\">\n                        <Circle size={8} fill=\"var(--foreground)\" color=\"var(--foreground)\" style={{ width: '8px', height: '8px', borderRadius: '50%', background: 'var(--foreground)' }} />\n                        <span className=\"text-sm\">Created {new Date(referral.createdAt).toLocaleString()}</span>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </>\n          );\n        })", "is_member_call": false, "source_file": "/Users/emmieb/work/swift-rms-client/src/app/(dashboard)/referrals/[id]/page.tsx", "source_location": "L279"}, {"caller_nid": "id_page_referraldetailpage", "callee": "trim", "is_member_call": true, "source_file": "/Users/emmieb/work/swift-rms-client/src/app/(dashboard)/referrals/[id]/page.tsx", "source_location": "L392"}, {"caller_nid": "id_page_referraldetailpage", "callee": "map", "is_member_call": true, "source_file": "/Users/emmieb/work/swift-rms-client/src/app/(dashboard)/referrals/[id]/page.tsx", "source_location": "L420"}, {"caller_nid": "id_page_referraldetailpage", "callee": "filter", "is_member_call": true, "source_file": "/Users/emmieb/work/swift-rms-client/src/app/(dashboard)/referrals/[id]/page.tsx", "source_location": "L420"}]}